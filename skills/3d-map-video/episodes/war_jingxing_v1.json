  },
  {
   "text": "对面号称二十万的赵军看见了",
   "hl": [
    "二十万",
    "赵军"
   ],
   "t": [
    8.863,
    11.235
   ]
  },
  {
   "text": "全营哈哈大笑",
   "hl": [
    "哈哈大笑"
   ],
   "t": [
    11.235,
    12.601
   ]
  },
  {
   "text": "人多、占着地利、还在笑话对手的一方",
   "hl": [],
   "t": [
    12.841,
    15.604
   ]
  },
  {
   "text": "为什么一天之内就输光了？",
   "hl": [
    "一天之内"
   ],
   "t": [
    15.604,
    17.626
   ]
  },
  {
   "text": "这一次，我们站在赵军这边看",
   "hl": [
    "赵军"
   ],
   "t": [
    17.966,
    20.212
   ]
  },
  {
   "text": "赵军主帅叫陈余，他守的地方叫井陉口",
   "hl": [
    "赵军",
    "陈余",
    "井陉口"
   ],
   "t": [
    20.452,
    24.139
   ]
  },
  {
   "text": "一般认为在今天石家庄鹿泉的土门关一带",
   "hl": [
    "土门关",
    "鹿泉"
   ],
   "t": [
    24.139,
    28.151
   ]
  },
  {
   "text": "从山西进河北，要穿过太行山的井陉道",
   "hl": [
    "井陉道"
   ],
   "t": [
    28.151,
    32.057
   ]
  },
  {
   "text": "史书说这条路，车不能并行",
   "hl": [
    "车不能并行"
   ],
   "t": [
    32.057,
    34.879
   ]
  },
  {
   "text": "骑兵排不成队",
   "hl": [],
   "t": [
    34.879,
    36.518
   ]
  },
  {
   "text": "汉军主将韩信，带着几万人",
   "hl": [
    "韩信",
    "几万人"
   ],
   "t": [
    36.518,
    38.79
   ]
  },
  {
   "text": "要从这条窄路里钻出来",
   "hl": [],
   "t": [
    38.79,
    40.833
   ]
  },
  {
   "text": "赵军号称二十万，堵在出口",
   "hl": [
    "二十万",
    "赵军"
   ],
   "t": [
    40.833,
    42.997
   ]
  },
  {
   "text": "怎么看都是稳赢",
   "hl": [
    "稳赢"
   ],
   "t": [
    42.997,
    44.449
   ]
  },
  {
   "text": "谋士李左车献计：给我三万奇兵",
   "hl": [
    "李左车",
    "三万奇兵"
   ],
   "t": [
    44.449,
    47.577
   ]
  },
  {
   "text": "抄小路断汉军粮草，不出十天",
   "hl": [
    "十天"
   ],
   "t": [
    47.577,
    50.496
   ]
  },
  {
   "text": "韩信的人头就能送到",
   "hl": [
    "韩信"
   ],
   "t": [
    50.496,
    52.701
   ]
  },
  {
   "text": "陈余不听，他说韩信号称几万",
   "hl": [
    "陈余",
    "韩信"
   ],
   "t": [
    52.701,
    55.342
   ]
  },
  {
   "text": "其实不过几千，躲着不打",
   "hl": [
    "不过几千"
   ],
   "t": [
    55.342,
    57.606
   ]
  },
  {
   "text": "会被诸侯笑话",
   "hl": [],
   "t": [
    57.606,
    59.046
   ]
  },
  {
   "text": "韩信探到这个消息，大喜",
   "hl": [
    "韩信"
   ],
   "t": [
    59.046,
    61.373
   ]
  },
  {
   "text": "在离井陉口三十里的地方停下扎营",
   "hl": [
    "井陉口",
    "三十里"
   ],
   "t": [
    61.373,
    64.595
   ]
  },
  {
   "text": "半夜，他派两千轻骑，每人带一面红旗",
   "hl": [
    "两千轻骑",
    "红旗"
   ],
   "t": [
    64.595,
    67.985
   ]
  },
  {
   "text": "抄小路上山，盯住赵营",
   "hl": [],
   "t": [
    67.985,
    70.177
   ]
  },
  {
   "text": "又派一万人先走，背靠河水列阵",
   "hl": [
    "一万人"
   ],
   "t": [
    70.177,
    72.65
   ]
  },
  {
   "text": "这就是开头那一幕",
   "hl": [],
   "t": [
    72.65,
    74.313
   ]
  },
  {
   "text": "在赵军看来，这是兵家大忌，退无可退",
   "hl": [
    "赵军",
    "兵家大忌"
   ],
   "t": [
    74.503,
    77.697
   ]
  },
  {
   "text": "所以才哈哈大笑",
   "hl": [
    "哈哈大笑"
   ],
   "t": [
    77.697,
    79.237
   ]
  },
  {
   "text": "天亮后，韩信打起大将的旗鼓",
   "hl": [
    "韩信",
    "旗鼓"
   ],
   "t": [
    79.237,
    81.792
   ]
  },
  {
   "text": "出井陉口挑战",
   "hl": [
    "井陉口"
   ],
   "t": [
    81.792,
    83.19
   ]
  },
  {
   "text": "赵军开营迎战，打了很久",
   "hl": [
    "赵军"
   ],
   "t": [
    83.19,
    85.829
   ]
  },
  {
   "text": "韩信假装败退，丢下旗鼓",
   "hl": [
    "韩信",
    "旗鼓"
   ],
   "t": [
    85.829,
    88.469
   ]
  },
  {
   "text": "退进河边的阵地",
   "hl": [],
   "t": [
    88.469,
    90.348
   ]
  },
  {
   "text": "赵军果然倾巢而出，争抢旗鼓",
   "hl": [
    "赵军",
    "旗鼓",
    "倾巢而出"
   ],
   "t": [
    90.348,
    93.006
   ]
  },
  {
   "text": "一路追到河边",
   "hl": [],
   "t": [
    93.006,
    94.455
   ]
  },
  {
   "text": "可背水的汉军没有退路，只能拼命",
   "hl": [
    "拼命"
   ],
   "t": [
    94.455,
    97.536
   ]
  },
  {
   "text": "赵军怎么也攻不下来",
   "hl": [
    "赵军"
   ],
   "t": [
    97.536,
    99.581
   ]
  },
  {
   "text": "这时，埋伏的两千骑兵冲进空营",
   "hl": [
    "空营"
   ],
   "t": [
    99.581,
    102.279
   ]
  },
  {
   "text": "拔掉赵旗，插上两千面汉军红旗",
   "hl": [
    "红旗"
   ],
   "t": [
    102.279,
    105.096
   ]
  },
  {
   "text": "赵军回头一看，营里全是汉旗",
   "hl": [
    "赵军",
    "汉旗"
   ],
   "t": [
    105.096,
    107.685
   ]
  },
  {
   "text": "以为赵王和将领都被俘了，当场大乱",
   "hl": [
    "大乱"
   ],
   "t": [
    107.685,
    110.948
   ]
  },
  {
   "text": "汉军前后夹击，陈余在泜水边被斩",
   "hl": [
    "陈余",
    "泜水"
   ],
   "t": [
    110.948,
    114.791
   ]
  },
  {
   "text": "赵王歇被活捉",
   "hl": [
    "赵王歇"
   ],
   "t": [
    114.791,
    116.652
   ]
  },
  {
   "text": "陈余输在两次看错：把奇计当成丢脸",
   "hl": [
    "陈余",
    "两次看错"
   ],
   "t": [
    116.892,
    120.932
   ]
  },
  {
   "text": "把背水当成送死",
   "hl": [],
   "t": [
    120.932,
    123.013
   ]
  },
  {
   "text": "韩信后来说，这叫陷之死地而后生",
   "hl": [
    "韩信",
    "陷之死地而后生"
   ],
   "t": [
    123.253,
    126.972
   ]
  },
  {
   "text": "他带的多是新兵，不逼到绝路就会跑",
   "hl": [],
   "t": [
    126.972,
    131.104
   ]
  },
  {
   "text": "笑别人没有退路的人",
   "hl": [],
   "t": [
    131.294,
    132.866
   ]
  },
  {
   "text": "往往忘了看自己的后路",
   "hl": [
    "后路"
   ],
   "t": [
    132.866,
    134.715
   ]
  },
  {
   "text": "这就是井陉：太行山的一个口子",
   "hl": [],
   "t": [
    134.715,
    136.92
   ]
  },
  {
   "text": "二十万人的一声笑",
   "hl": [
    "二十万",
    "一声笑"
   ],
   "t": [
    136.92,
    138.423
   ]
  }
